# Public URL used for callbacks and payment links.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Database used by Better Auth and future durable invoice storage.
# Use a pooled Postgres URL from Neon, Supabase, or another Postgres provider.
DATABASE_URL=

# Better Auth production settings. Generate a long random secret; never commit it.
BETTER_AUTH_URL=https://your-app.vercel.app
BETTER_AUTH_SECRET=
VITE_AUTH_ENABLED=true

# Optional federated auth broker settings. Email/password works without these.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Optional Razorpay (India). Use test keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
